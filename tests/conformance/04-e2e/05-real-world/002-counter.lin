// CATEGORY: e2e
// DESCRIPTION: counter struct with methods
// EXPECTED: compile_error
// ERROR_PATTERN: error
// SOURCE: Stage 10.4 conformance expansion

struct Counter { count: i32 } impl Counter { fn new() -> Counter { Counter { count: 0 } } fn inc(&mut self) { self.count += 1; } fn get(&self) -> i32 { self.count } } fn main() { let mut c = Counter::new(); c.inc(); c.get(); }
