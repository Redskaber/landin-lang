struct Stack{data:[i32;10],top:i32} impl Stack{fn new()->Stack{Stack{data:[0;10],top:0}}fn push(&mut self,v:i32){self.data[self.top as usize]=v;self.top+=1;}fn pop(&mut self)->i32{self.top-=1;self.data[self.top as usize]}}
impl Copy for Stack {}
