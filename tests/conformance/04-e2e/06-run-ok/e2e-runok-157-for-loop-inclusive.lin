// CATEGORY: e2e
// DESCRIPTION: for-loop over inclusive range (start..=end)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 15
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.97 — for-loop over Range support (inclusive)

fn main() {
    let mut sum = 0;
    for i in 0..=5 {
        sum += i;
    }
    println!("{}", sum);
}
