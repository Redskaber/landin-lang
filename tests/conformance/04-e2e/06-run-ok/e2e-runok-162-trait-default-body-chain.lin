// CATEGORY: e2e
// DESCRIPTION: Trait default body that calls multiple trait methods
// EXPECTED: run_ok
// EXPECTED_STDOUT: 26
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.97 — Bug Y1 fix (multiple trait method dispatch from default body)

trait Counter {
    fn value(&self) -> i32;
    fn increment(&self) -> i32 {
        self.value() + 1
    }
    fn doubled_increment(&self) -> i32 {
        self.increment() * 2
    }
}

struct Pair { x: i32 }
impl Copy for Pair {}

impl Counter for Pair {
    fn value(&self) -> i32 {
        self.x
    }
}

fn main() {
    let p = Pair { x: 12 };
    // doubled_increment calls increment (default) calls value (impl)
    // 12 -> 13 -> 26
    println!("{}", p.doubled_increment());
}
