// CATEGORY: e2e
// DESCRIPTION: run_ok Char to int cast and back — Stage 14.65
// EXPECTED: run_ok
// EXPECTED_STDOUT: 98
// SOURCE: Stage 14.65 — emit_cast used LLVMBuildBitCast for integer-to-integer casts of different widths (i32→i8),
// producing "Invalid bitcast" LLVM verification errors

fn next_char(c: char) -> char {
    let n = c as i32;
    let next = n + 1;
    next as char
}

fn main() -> i32 {
    let c = next_char('a');
    println!("{}", c);
    0
}
