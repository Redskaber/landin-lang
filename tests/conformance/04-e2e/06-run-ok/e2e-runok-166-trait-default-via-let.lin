// CATEGORY: e2e
// DESCRIPTION: Method chain via let-bound trait default body result (Bug Z3)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 8
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.98 — Bug Z3 fix (resolve_trait_method in MethodCall-init tracing)

trait T {
    fn f(&self) -> i32 { 7 }
    fn g(&self) -> i32 { self.f() + 1 }
}
struct P { x: i32 }
impl T for P {}
fn main() {
    let p = P { x: 10 };
    let r1 = p;
    let r2 = r1.g();
    println!("{}", r2);
}
