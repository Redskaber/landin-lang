// DESCRIPTION: run_ok early return with value (Stage 14.23 fix)
// EXPECTED: run_ok
// EXPECTED_STDOUT: -1 0 1
// SOURCE: Stage 14.23 — return value + return after if verification

fn classify(n: i32) -> i32 {
    if n < 0 { return -1; }
    if n == 0 { return 0; }
    return 1;
}
fn main() -> i32 {
    let a = classify(-5);
    let b = classify(0);
    let c = classify(42);
    println!("{} {} {}", a, b, c);
    0
}
