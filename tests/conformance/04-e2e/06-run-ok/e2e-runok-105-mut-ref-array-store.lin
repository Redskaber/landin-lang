// CATEGORY: e2e
// DESCRIPTION: run_ok &mut [i32; N] array element mutation through reference param — Stage 14.62
// EXPECTED: run_ok
// EXPECTED_STDOUT: 100 200 300
// SOURCE: Stage 14.62 — store path Ref dereference + Array type extraction (mirrors Stage 14.61 load fix)

fn modify(arr: &mut [i32; 3]) {
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
}
fn main() -> i32 {
    let mut data = [1, 2, 3];
    modify(&mut data);
    println!("{} {} {}", data[0], data[1], data[2]);
    0
}
