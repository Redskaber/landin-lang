// CATEGORY: e2e
// DESCRIPTION: run_ok match with or-pattern (2 | 3)
// EXPECTED: run_ok
// EXPECTED_STDOUT: label: small
// SOURCE: Stage 14.28 — match or-pattern verification

fn main() -> i32 {
    let n = 3;
    let label = match n {
        0 => { "zero" }
        1 => { "one" }
        2 | 3 => { "small" }
        _ => { "large" }
    };
    println!("label: {}", label);
    0
}
