// CATEGORY: e2e
// DESCRIPTION: run_ok inline chained method call (no let binding for intermediates) — Stage 14.40
// EXPECTED: run_ok
// EXPECTED_STDOUT: 10
// SOURCE: Stage 14.40 — verifies that V::new(1, 2).add(V::new(3, 4)).get() works inline

struct V { x: i32, y: i32 }
impl Copy for V {}
impl V {
    fn new(x: i32, y: i32) -> V { V { x, y } }
    fn add(self, o: V) -> V { V { x: self.x + o.x, y: self.y + o.y } }
    fn get(self) -> i32 { self.x + self.y }
}
fn main() -> i32 {
    let r = V::new(1, 2).add(V::new(3, 4)).get();
    println!("{}", r);
    0
}
