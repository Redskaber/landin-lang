// CATEGORY: e2e
// DESCRIPTION: run_ok while with break (early exit)
// EXPECTED: run_ok
// EXPECTED_STDOUT: found=5
// SOURCE: Stage 14.33 — while + break + if verification

fn main() -> i32 {
    let mut i = 0;
    let mut found = 0;
    while i < 100 {
        if i * i > 20 {
            found = i;
            break;
        }
        i += 1;
    }
    println!("found={}", found);
    0
}
