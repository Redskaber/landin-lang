// CATEGORY: e2e
// DESCRIPTION: run_ok Enum method with match on &self — Stage 14.66
// EXPECTED: run_ok
// EXPECTED_STDOUT: 10\n99
// SOURCE: Stage 14.66 — enum match on &self failed with "Invalid indices for GEP pointer type" because
// codegen didn't dereference &self before GEP-ing into enum fields. Fixed by adding Deref projection
// for Ref scrutinees in match lowering and pattern bindings.

enum Opt2 {
    None,
    Some(i32),
}
impl Opt2 {
    fn unwrap_or(&self, default: i32) -> i32 {
        match self {
            Opt2::None => default,
            Opt2::Some(v) => *v,
        }
    }
}

fn main() -> i32 {
    let some = Opt2::Some(10);
    let none = Opt2::None;
    println!("{}", some.unwrap_or(0));
    println!("{}", none.unwrap_or(99));
    0
}
