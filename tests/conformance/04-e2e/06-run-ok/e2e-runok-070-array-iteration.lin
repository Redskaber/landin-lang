// DESCRIPTION: run_ok array iteration with while loop + index — Stage 14.45
// EXPECTED: run_ok
// EXPECTED_STDOUT: 150
// SOURCE: Stage 14.45 — array iteration pattern verification

fn main() -> i32 {
    let arr = [10, 20, 30, 40, 50];
    let mut i = 0;
    let mut sum = 0;
    while i < 5 {
        sum = sum + arr[i];
        i = i + 1;
    }
    println!("{}", sum);
    0
}
