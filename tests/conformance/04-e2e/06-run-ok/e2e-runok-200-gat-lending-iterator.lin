// DESCRIPTION: GAT run_ok — LendingIterator produces correct values at runtime
// EXPECTED: run_ok
// EXPECTED_STDOUT: 3\n
// SOURCE: Stage 18.66 test coverage audit

trait LendingIterator {
    type Item<'a>;
    fn next<'a>(&'a mut self) -> Self::Item<'a>;
}

struct Counter {
    count: i32,
}

impl LendingIterator for Counter {
    type Item<'a> = i32;
    fn next<'a>(&'a mut self) -> i32 {
        self.count += 1;
        self.count
    }
}

fn main() {
    let mut c = Counter { count: 0 };
    let _a = c.next();
    let _b = c.next();
    let c2 = c.next();
    println!("{}", c2);
}
