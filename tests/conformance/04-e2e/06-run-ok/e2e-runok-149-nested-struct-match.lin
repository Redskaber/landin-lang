// CATEGORY: e2e
// DESCRIPTION: run_ok Nested struct pattern in match — Stage 14.88
// EXPECTED: run_ok
// EXPECTED_STDOUT: 1\n2\n3
// SOURCE: Stage 14.88 — Round 4 audit fix: nested struct pattern bindings
//         in match context were broken (LLVM verification error). Now
//         correctly extracts inner struct to temp local before recursing.

struct Inner { a: i32, b: i32 }
impl Copy for Inner {}
struct Outer { inner: Inner, c: i32 }
impl Copy for Outer {}
fn main() -> i32 {
    let o = Outer { inner: Inner { a: 1, b: 2 }, c: 3 };
    match o {
        Outer { inner: Inner { a, b }, c } => {
            println!("{}", a);  // 1
            println!("{}", b);  // 2
            println!("{}", c);  // 3
        }
    }
    0
}
