// CATEGORY: e2e
// DESCRIPTION: run_ok Struct with literal sub-patterns in match — Stage 14.89
// EXPECTED: run_ok
// EXPECTED_STDOUT: 100\n200\n300
// SOURCE: Stage 14.89 — Bug 3 fix: struct patterns with literal sub-patterns
//         were not checked (fell through to catch-all). Now correctly checks
//         each literal sub-pattern by field name lookup.

struct Config { mode: i32, val: i32 }
impl Copy for Config {}
fn classify(c: Config) -> i32 {
    match c {
        Config { mode: 0, val: _ } => 100,
        Config { mode: 1, val: _ } => 200,
        _ => 300,
    }
}
fn main() -> i32 {
    println!("{}", classify(Config { mode: 0, val: 99 }));  // 100
    println!("{}", classify(Config { mode: 1, val: 99 }));  // 200
    println!("{}", classify(Config { mode: 2, val: 99 }));  // 300
    0
}
