// CATEGORY: e2e
// DESCRIPTION: run_ok power function recursive (2^10, 3^5, 5^0) — Stage 14.56
// EXPECTED: run_ok
// EXPECTED_STDOUT: 1024\n243\n1
// SOURCE: Stage 14.56 — recursive power with 3 branches (exp=0, exp=1, recursive)

fn power(base: i32, exp: i32) -> i32 {
    if exp == 0 {
        1
    } else if exp == 1 {
        base
    } else {
        base * power(base, exp - 1)
    }
}
fn main() -> i32 {
    println!("{}", power(2, 10));
    println!("{}", power(3, 5));
    println!("{}", power(5, 0));
    0
}
