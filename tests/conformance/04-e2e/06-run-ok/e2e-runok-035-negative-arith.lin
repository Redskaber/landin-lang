fn main() -> i32 {
    let a = (-5) + (-3);
    let b = 3 * (-4);
    let c = (-3) * (-4);
    let d = 10 / (-3);
    let e = (-10) / 3;
    let f = 10 % (-3);
    println!("{} {} {} {} {} {}", a, b, c, d, e, f);
    0
}
