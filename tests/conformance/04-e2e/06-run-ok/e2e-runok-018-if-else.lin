// CATEGORY: e2e
// DESCRIPTION: run_ok if-else chain + early return
// EXPECTED: run_ok
// EXPECTED_STDOUT: grade=B
// SOURCE: Stage 14.16 — if-else chain + early return verification

fn grade(score: i32) -> i32 {
    if score >= 90 {
        1  // A
    } else if score >= 80 {
        2  // B
    } else if score >= 70 {
        3  // C
    } else {
        4  // F
    }
}
fn main() -> i32 {
    let g = grade(85);
    let label = match g {
        1 => "A",
        2 => "B",
        3 => "C",
        _ => "F",
    };
    println!("grade={}", label);
    0
}
