// CATEGORY: e2e
// DESCRIPTION: run_ok Conditional swap in loop (bubble sort one pass) — Stage 14.64
// EXPECTED: run_ok
// EXPECTED_STDOUT: 3 1 4 2 5
// SOURCE: Stage 14.64 — comparison results zext'd to i32 caused type mismatch when stored to Bool locals,
// producing wrong bubble sort output (0 0 1 2 4 instead of 3 1 4 2 5)

fn bubble_sort_pass(arr: [i32; 5]) -> [i32; 5] {
    let mut result = arr;
    let mut i = 0;
    while i < 4 {
        if result[i] > result[i + 1] {
            let tmp = result[i];
            result[i] = result[i + 1];
            result[i + 1] = tmp;
        }
        i = i + 1;
    }
    result
}

fn main() -> i32 {
    let arr = bubble_sort_pass([5, 3, 1, 4, 2]);
    println!("{} {} {} {} {}", arr[0], arr[1], arr[2], arr[3], arr[4]);
    0
}
