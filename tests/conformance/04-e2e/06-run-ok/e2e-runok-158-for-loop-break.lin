// CATEGORY: e2e
// DESCRIPTION: for-loop with break statement
// EXPECTED: run_ok
// EXPECTED_STDOUT: 6
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.97 — for-loop with break support

fn main() {
    let mut sum = 0;
    for i in 0..100 {
        if i > 3 {
            break;
        }
        sum += i;
    }
    println!("{}", sum);
}
