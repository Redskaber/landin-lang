// CATEGORY: e2e
// DESCRIPTION: run_ok String comparison across function boundaries — Stage 14.70
// EXPECTED: run_ok
// EXPECTED_STDOUT: 1\n2\n3\n0
// SOURCE: Stage 14.70 — fixed fat pointer {ptr, i64} ABI corruption: interpret_adhoc parsed
// integer literals as i32, causing LLVM to store only 4 bytes (movl) instead of 8 (movq) for
// the i64 len field. Fixed by coercing insertvalue values to the field's type.

fn classify_name(name: &str) -> i32 {
    if name == "Alice" {
        1
    } else if name == "Bob" {
        2
    } else if name == "Charlie" {
        3
    } else {
        0
    }
}

fn main() -> i32 {
    println!("{}", classify_name("Alice"));   // 1
    println!("{}", classify_name("Bob"));     // 2
    println!("{}", classify_name("Charlie")); // 3
    println!("{}", classify_name("Unknown")); // 0
    0
}
