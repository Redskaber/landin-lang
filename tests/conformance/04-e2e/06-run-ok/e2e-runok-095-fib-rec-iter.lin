// CATEGORY: e2e
// DESCRIPTION: run_ok Fibonacci recursive + iterative comparison — Stage 14.56
// EXPECTED: run_ok
// EXPECTED_STDOUT: 610 610
// SOURCE: Stage 14.56 — recursive + iterative fib(15) comparison

fn fib_rec(n: i32) -> i32 {
    if n < 2 { n } else { fib_rec(n - 1) + fib_rec(n - 2) }
}
fn fib_iter(n: i32) -> i32 {
    let mut a = 0;
    let mut b = 1;
    let mut i = 0;
    while i < n {
        let tmp = a + b;
        a = b;
        b = tmp;
        i = i + 1;
    }
    a
}
fn main() -> i32 {
    let r1 = fib_rec(15);
    let r2 = fib_iter(15);
    println!("{} {}", r1, r2);
    0
}
