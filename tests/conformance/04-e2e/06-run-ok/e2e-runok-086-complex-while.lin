fn main() -> i32 {
    let mut i = 0;
    let mut sum = 0;
    while i < 10 && sum < 30 {
        if i % 2 == 0 {
            sum = sum + i;
        }
        i = i + 1;
    }
    println!("{}", sum);
    0
}
