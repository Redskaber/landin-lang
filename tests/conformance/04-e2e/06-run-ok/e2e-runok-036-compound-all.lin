// CATEGORY: e2e
// DESCRIPTION: run_ok all compound assignment operators (+=, -=, *=, /=, %=)
// EXPECTED: run_ok
// EXPECTED_STDOUT: x=13
// SOURCE: Stage 14.25 — compound assignment *= /= verification

fn main() -> i32 {
    let mut x = 10;
    x += 5;   // 15
    x -= 2;   // 13
    x *= 2;   // 26
    x /= 2;   // 13
    x %= 20;  // 13
    println!("x={}", x);
    0
}
