// CATEGORY: e2e
// DESCRIPTION: Method call on struct literal created inside for-loop body (Bug Z1)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 3
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.98 — Bug Z1/Z2/Z4 fix (search_expr_for_local_init recursion)

struct N { v: i32 }
impl N { fn base(&self) -> i32 { self.v } }
fn main() {
    let mut sum = 0;
    for i in 0..3 {
        let n = N { v: i };
        sum += n.base();
    }
    println!("{}", sum);
}
