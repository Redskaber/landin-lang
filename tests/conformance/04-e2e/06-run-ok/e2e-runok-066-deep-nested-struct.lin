// CATEGORY: e2e
// DESCRIPTION: run_ok deeply nested struct (3 levels) mutation through method call — Stage 14.43
// EXPECTED: run_ok
// EXPECTED_STDOUT: 99
// SOURCE: Stage 14.43 — recursive adt_layouts registration (was 1-level only) + nested Field projection

struct L3 { val: i32 }
struct L2 { inner: L3 }
struct L1 { inner: L2 }
impl L1 {
    fn new(v: i32) -> L1 { L1 { inner: L2 { inner: L3 { val: v } } } }
    fn set(&mut self, v: i32) {
        self.inner.inner.val = v;
    }
    fn get(self) -> i32 { self.inner.inner.val }
}
fn main() -> i32 {
    let mut o = L1::new(10);
    o.set(99);
    println!("{}", o.get());
    0
}
