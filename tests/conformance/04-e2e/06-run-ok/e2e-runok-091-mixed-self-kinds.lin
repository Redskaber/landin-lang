// CATEGORY: e2e
// DESCRIPTION: run_ok mixed self kinds (&mut self + self + &self) on same type — Stage 14.54
// EXPECTED: run_ok
// EXPECTED_STDOUT: 30\n0
// SOURCE: Stage 14.54 — mixed &mut self / self / &self methods + reset pattern

struct Counter { val: i32 }
impl Counter {
    fn new() -> Counter { Counter { val: 0 } }
    fn add(&mut self, n: i32) -> &mut Counter { self.val = self.val + n; self }
    fn get(&self) -> i32 { self.val }
    fn reset(self) -> Counter { Counter { val: 0 } }
}
fn main() -> i32 {
    let mut c = Counter::new();
    c.add(10);
    c.add(20);
    println!("{}", c.get());
    let c2 = c.reset();
    println!("{}", c2.get());
    0
}
