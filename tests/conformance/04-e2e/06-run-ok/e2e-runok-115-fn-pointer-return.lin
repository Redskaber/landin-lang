// DESCRIPTION: run_ok Function returning function pointer (forward reference) — Stage 14.65
// EXPECTED: run_ok
// EXPECTED_STDOUT: 42
// SOURCE: Stage 14.65 — FnDef constant referenced before function body emitted got null pointer (LLVMGetNamedFunction
// returned null), causing segfault when the function was later called. Fixed by looking up signature in fn_sigs.

fn adder(x: i32) -> fn(i32) -> i32 {
    double
}
fn double(x: i32) -> i32 { x * 2 }

fn main() -> i32 {
    let f = adder(5);
    println!("{}", f(21));
    0
}
