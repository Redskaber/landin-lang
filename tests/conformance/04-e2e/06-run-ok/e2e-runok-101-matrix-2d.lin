// CATEGORY: e2e
// DESCRIPTION: run_ok 2D matrix (array of arrays) traversal — Stage 14.60
// EXPECTED: run_ok
// EXPECTED_STDOUT: 45
// SOURCE: Stage 14.60 — nested array indexing (m[i][j]) + nested while loops

fn main() -> i32 {
    let m = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    let mut sum = 0;
    let mut i = 0;
    while i < 3 {
        let mut j = 0;
        while j < 3 {
            sum = sum + m[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    println!("{}", sum);
    0
}
