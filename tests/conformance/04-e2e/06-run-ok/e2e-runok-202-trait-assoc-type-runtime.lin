// CATEGORY: e2e
// DESCRIPTION: Trait method with associated type run_ok — resolves correctly at runtime
// EXPECTED: run_ok
// EXPECTED_STDOUT: 42\n
// SOURCE: Stage 18.66 test coverage audit

trait Container {
    type Item;
    fn get(&self) -> Self::Item;
}

struct Store {
    val: i32,
}

impl Container for Store {
    type Item = i32;
    fn get(&self) -> i32 { self.val }
}

fn main() {
    let s = Store { val: 42 };
    let v = s.get();
    println!("{}", v);
}
