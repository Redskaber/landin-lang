// CATEGORY: e2e
// DESCRIPTION: run_ok stack data structure with &mut self + array field
// EXPECTED: run_ok
// EXPECTED_STDOUT: pop=30, pop=20, pop=10
// SOURCE: Stage 14.21 — &mut self + array field + index assignment verification

struct Stack { data: [i32; 5], top: i32 }
impl Stack {
    fn new() -> Stack { Stack { data: [0; 5], top: 0 } }
    fn push(&mut self, val: i32) { self.data[self.top] = val; self.top += 1; }
    fn pop(&mut self) -> i32 { self.top -= 1; self.data[self.top] }
}
fn main() -> i32 {
    let mut s = Stack::new();
    s.push(10);
    s.push(20);
    s.push(30);
    println!("pop={}, pop={}, pop={}", s.pop(), s.pop(), s.pop());
    0
}
