struct Point { x: i32, y: i32 }
impl Copy for Point {}
impl Point {
    fn sum(&self) -> i32 { self.x + self.y }
}
fn main() -> i32 {
    let p = Point { x: 10, y: 20 };
    println!("sum={}", p.sum());
    p.sum()
}
