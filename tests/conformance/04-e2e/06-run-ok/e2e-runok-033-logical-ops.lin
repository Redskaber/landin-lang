// CATEGORY: e2e
// DESCRIPTION: run_ok logical operators with short-circuit evaluation
// EXPECTED: run_ok
// EXPECTED_STDOUT: a=true, b=false, c=true, d=false
// SOURCE: Stage 14.24 — && and || with short-circuit verification

fn main() -> i32 {
    let a = true && true;
    let b = true && false;
    let c = false || true;
    let d = false || false;
    println!("a={}, b={}, c={}, d={}", a, b, c, d);
    0
}
