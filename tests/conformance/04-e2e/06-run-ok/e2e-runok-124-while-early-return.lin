// CATEGORY: e2e
// DESCRIPTION: run_ok While loop with early return — Stage 14.68
// EXPECTED: run_ok
// EXPECTED_STDOUT: 2
// SOURCE: Stage 14.68 — `while i < 5 { return i; } -1` was parsed as `(while_result) - 1` (binary
// subtraction), causing type errors because while returns unit. Fixed by making block-like
// expressions statement boundaries for binary operators.

fn find_first(arr: [i32; 5], target: i32) -> i32 {
    let mut i = 0;
    while i < 5 {
        if arr[i] == target {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn main() -> i32 {
    println!("{}", find_first([10, 20, 30, 40, 50], 30));
    0
}
