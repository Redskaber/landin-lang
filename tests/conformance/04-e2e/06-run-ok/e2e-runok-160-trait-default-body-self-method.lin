// CATEGORY: e2e
// DESCRIPTION: Trait default body calling another trait method (Bug Y1)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 42
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.97 — Bug Y1 fix (trait default body self.method() dispatch)

trait Counter {
    fn value(&self) -> i32;
    fn double_value(&self) -> i32 {
        self.value() * 2
    }
}

struct Pair { x: i32 }
impl Copy for Pair {}

impl Counter for Pair {
    fn value(&self) -> i32 {
        self.x
    }
}

fn main() {
    let p = Pair { x: 21 };
    println!("{}", p.double_value());
}
