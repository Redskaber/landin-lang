// CATEGORY: e2e
// DESCRIPTION: run_ok Tuple match with literal sub-patterns and wildcards — Stage 14.67
// EXPECTED: run_ok
// EXPECTED_STDOUT: 0\n1\n2\n3\n4
// SOURCE: Stage 14.67 — match on tuple with literal sub-patterns (0, _), (_, 0), (a, b) always
// matched the first arm (no conditional checks). Fixed by generating field comparison checks.

fn classify_pair(p: (i32, i32)) -> i32 {
    match p {
        (0, 0) => 0,
        (0, _) => 1,
        (_, 0) => 2,
        (a, b) => if a > b { 3 } else { 4 },
    }
}

fn main() -> i32 {
    println!("{}", classify_pair((0, 0)));   // 0
    println!("{}", classify_pair((0, 5)));   // 1
    println!("{}", classify_pair((5, 0)));   // 2
    println!("{}", classify_pair((10, 5)));  // 3
    println!("{}", classify_pair((5, 10)));  // 4
    0
}
