// CATEGORY: e2e
// DESCRIPTION: run_ok Stack with push/pop/peek (&mut self + array field mutation) — Stage 14.60
// EXPECTED: run_ok
// EXPECTED_STDOUT: 30\n30\n20\n10
// SOURCE: Stage 14.60 — comprehensive Stack data structure with &mut self methods

struct Stack { data: [i32; 5], top: i32 }
impl Copy for Stack {}
impl Stack {
    fn new() -> Stack { Stack { data: [0; 5], top: 0 } }
    fn push(&mut self, val: i32) {
        self.data[self.top] = val;
        self.top = self.top + 1;
    }
    fn pop(&mut self) -> i32 {
        self.top = self.top - 1;
        self.data[self.top]
    }
    fn peek(&self) -> i32 {
        self.data[self.top - 1]
    }
}
fn main() -> i32 {
    let mut s = Stack::new();
    s.push(10);
    s.push(20);
    s.push(30);
    println!("{}", s.peek());
    println!("{}", s.pop());
    println!("{}", s.pop());
    println!("{}", s.peek());
    0
}
