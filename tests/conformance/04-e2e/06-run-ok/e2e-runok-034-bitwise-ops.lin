// CATEGORY: e2e
// DESCRIPTION: run_ok bitwise operators (&, |, ^, <<, >>)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 8 14 6 16 16
// SOURCE: Stage 14.24 — bitwise operators verification

fn main() -> i32 {
    let a = 12 & 10;
    let b = 12 | 10;
    let c = 12 ^ 10;
    let d = 1 << 4;
    let e = 256 >> 4;
    println!("{} {} {} {} {}", a, b, c, d, e);
    0
}
