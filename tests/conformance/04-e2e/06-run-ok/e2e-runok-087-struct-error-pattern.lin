// CATEGORY: e2e
// DESCRIPTION: run_ok struct return as multi-value result (error pattern) — Stage 14.53
// EXPECTED: run_ok
// EXPECTED_STDOUT: 5 1 0 0
// SOURCE: Stage 14.53 — struct return for error handling pattern

struct Result { val: i32, ok: i32 }
fn divide(a: i32, b: i32) -> Result {
    if b == 0 {
        Result { val: 0, ok: 0 }
    } else {
        Result { val: a / b, ok: 1 }
    }
}
fn main() -> i32 {
    let r1 = divide(10, 2);
    let r2 = divide(10, 0);
    println!("{} {} {} {}", r1.val, r1.ok, r2.val, r2.ok);
    0
}
