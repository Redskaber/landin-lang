struct Point { x: i32, y: i32 }
struct Rect { tl: Point, br: Point }
fn main() -> i32 {
    let r = Rect { tl: Point { x: 0, y: 0 }, br: Point { x: 10, y: 20 } };
    println!("tl.x={}, br.y={}", r.tl.x, r.br.y);
    0
}
