// CATEGORY: e2e
// DESCRIPTION: run_ok struct construction + field access + method
// EXPECTED: run_ok
// EXPECTED_STDOUT: p.x=10, p.y=20, sum=30
// EXPECTED_EXIT_CODE: 30
// SOURCE: Stage 14.16 — struct + impl method + self.x field access verification

struct Pair { x: i32, y: i32 }
impl Copy for Pair {}
impl Pair {
    fn sum(self) -> i32 { self.x + self.y }
}
fn main() -> i32 {
    let p = Pair { x: 10, y: 20 };
    println!("p.x={}, p.y={}, sum={}", p.x, p.y, p.sum());
    p.sum()
}
