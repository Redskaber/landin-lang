// CATEGORY: e2e
// DESCRIPTION: run_ok While loop followed by tuple expression — Stage 14.63
// EXPECTED: run_ok
// EXPECTED_STDOUT: 5 120
// SOURCE: Stage 14.63 — parser was misparsing `while {} (n, acc)` as a Call to the while loop's unit result

fn fact_pair(n: i32) -> (i32, i32) {
    let mut i = 1;
    let mut acc = 1;
    while i <= n {
        acc = acc * i;
        i = i + 1;
    }
    (n, acc)
}

fn main() -> i32 {
    let (n, f) = fact_pair(5);
    println!("{} {}", n, f);
    0
}
