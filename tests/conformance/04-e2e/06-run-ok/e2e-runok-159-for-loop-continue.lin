// CATEGORY: e2e
// DESCRIPTION: for-loop with continue statement
// EXPECTED: run_ok
// EXPECTED_STDOUT: 9
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.97 — for-loop with continue support

fn main() {
    let mut sum = 0;
    for i in 0..6 {
        if i == 2 || i == 4 {
            continue;
        }
        sum += i;
    }
    println!("{}", sum);
}
