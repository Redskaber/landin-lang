// CATEGORY: e2e
// DESCRIPTION: run_ok while loop with accumulation
// EXPECTED: run_ok
// EXPECTED_STDOUT: sum=10
// EXPECTED_EXIT_CODE: 10
// SOURCE: Stage 14.16 — while loop + compound assign verification

fn main() -> i32 {
    let mut i = 0;
    let mut sum = 0;
    while i < 5 {
        sum += i;
        i += 1;
    }
    println!("sum={}", sum);
    sum
}
