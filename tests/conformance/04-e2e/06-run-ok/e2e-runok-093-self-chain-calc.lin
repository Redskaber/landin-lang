// DESCRIPTION: run_ok self-by-value method chain calculator — Stage 14.55
// EXPECTED: run_ok
// EXPECTED_STDOUT: 45
// SOURCE: Stage 14.55 — comprehensive self-chain calculator (add+add+mul)

struct Calc { result: i32 }
impl Copy for Calc {}
impl Calc {
    fn new() -> Calc { Calc { result: 0 } }
    fn add(self, n: i32) -> Calc { Calc { result: self.result + n } }
    fn mul(self, n: i32) -> Calc { Calc { result: self.result * n } }
    fn get(self) -> i32 { self.result }
}
fn main() -> i32 {
    let c = Calc::new().add(10).add(5).mul(3);
    println!("{}", c.get());
    0
}
