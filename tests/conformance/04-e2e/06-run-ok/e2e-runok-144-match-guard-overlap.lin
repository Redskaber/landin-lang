// CATEGORY: e2e
// DESCRIPTION: run_ok Match guard with overlapping unguarded arm — Stage 14.87
// EXPECTED: run_ok
// EXPECTED_STDOUT: 100\n100\n300
// SOURCE: Stage 14.87 — Bug A fix: guarded arm's literal value claimed by
//         subsequent unguarded arm. Was: unguarded arm matched via switch,
//         bypassing the guarded arm.

fn classify(n: i32) -> i32 {
    match n {
        0 if n == 0 => 100,   // guarded — claims value 0
        0 => 200,             // unguarded — value 0 was claimed, evaluated in otherwise
        _ => 300,
    }
}

fn main() -> i32 {
    println!("{}", classify(0));  // 100 (guarded arm: 0==0, guard passes)
    println!("{}", classify(0));  // 100 (same — guarded arm always wins for 0)
    println!("{}", classify(1));  // 300 (falls to _)
    0
}


