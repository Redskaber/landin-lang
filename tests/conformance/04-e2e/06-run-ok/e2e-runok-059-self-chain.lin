// DESCRIPTION: run_ok self-by-value method chain (functional update style) — Stage 14.42
// EXPECTED: run_ok
// EXPECTED_STDOUT: 13
// SOURCE: Stage 14.42 — method chain resolution for MethodCall receivers + auto-deref

struct Counter { val: i32 }
impl Counter {
    fn new() -> Counter { Counter { val: 0 } }
    fn inc(self) -> Counter { Counter { val: self.val + 1 } }
    fn add(self, n: i32) -> Counter { Counter { val: self.val + n } }
    fn get(self) -> i32 { self.val }
}
fn main() -> i32 {
    let c = Counter::new().inc().inc().add(10).inc();
    println!("{}", c.get());
    0
}
