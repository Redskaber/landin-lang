struct Point { x: i32, y: i32 }
impl Copy for Point {}
impl Point {
    fn new(x: i32, y: i32) -> Point { Point { x, y } }
    fn sum(self) -> i32 { self.x + self.y }
}
fn main() -> i32 {
    let points = [Point::new(1, 2), Point::new(3, 4)];
    let total = points[0].sum() + points[1].sum();
    println!("{}", total);
    0
}
