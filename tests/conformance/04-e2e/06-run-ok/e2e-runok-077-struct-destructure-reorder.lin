struct Point { x: i32, y: i32, z: i32 }
impl Copy for Point {}
fn main() -> i32 {
    let p = Point { x: 1, y: 2, z: 3 };
    let Point { z, x, y } = p;
    println!("{} {} {}", x, y, z);
    0
}
