// EXPECTED: run_ok
// EXPECTED_STDOUT: 1 2 3
// SOURCE: Stage 14.50 — nested struct destructure `let Outer { inner: Inner { a, b }, c } = o` now works

struct Inner { a: i32, b: i32 }
struct Outer { inner: Inner, c: i32 }
fn main() -> i32 {
    let o = Outer { inner: Inner { a: 1, b: 2 }, c: 3 };
    let Outer { inner: Inner { a, b }, c } = o;
    println!("{} {} {}", a, b, c);
    0
}
