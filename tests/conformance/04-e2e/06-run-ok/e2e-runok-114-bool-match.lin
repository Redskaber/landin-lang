// CATEGORY: e2e
// DESCRIPTION: run_ok Bool match with both true and false arms — Stage 14.65
// EXPECTED: run_ok
// EXPECTED_STDOUT: 1\n0
// SOURCE: Stage 14.65 — codegen assumed "false goes to otherwise" for bool match, skipping the false arm's body
// entirely. match b { true => 1, false => 0 } returned garbage for false instead of 0.

fn bool_to_str(b: bool) -> i32 {
    match b {
        true => 1,
        false => 0,
    }
}

fn main() -> i32 {
    println!("{}", bool_to_str(true));
    println!("{}", bool_to_str(false));
    0
}
