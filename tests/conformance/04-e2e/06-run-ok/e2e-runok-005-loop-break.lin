// CATEGORY: e2e
// DESCRIPTION: run_ok loop with break and counter
// EXPECTED: run_ok
// EXPECTED_STDOUT: count=10
// SOURCE: Stage 14.11 (GAP-8) — run_ok runner verification

fn main() -> i32 {
    let mut i = 0;
    let mut count = 0;
    loop {
        if i >= 10 { break; }
        count += 1;
        i += 1;
    }
    println!("count={}", count);
    0
}
