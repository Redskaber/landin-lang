struct Pair { x: i32, y: i32 }
impl Pair {
    fn sum(self) -> i32 { self.x + self.y }
}
fn main() -> i32 {
    let p = Pair { x: 10, y: 20 };
    println!("sum={}", p.sum());
    p.sum()
}
