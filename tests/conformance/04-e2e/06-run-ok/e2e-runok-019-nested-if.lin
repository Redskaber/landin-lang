// CATEGORY: e2e
// DESCRIPTION: run_ok nested if-else control flow
// EXPECTED: run_ok
// EXPECTED_STDOUT: x is positive and less than y
// EXPECTED_EXIT_CODE: 15
// SOURCE: Stage 14.17 — nested control flow verification

fn main() -> i32 {
    let x = 5;
    let y = 10;
    if x < y {
        if x > 0 {
            println!("x is positive and less than y");
        }
    }
    x + y
}
