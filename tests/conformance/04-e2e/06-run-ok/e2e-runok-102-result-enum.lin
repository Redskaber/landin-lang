// CATEGORY: e2e
// DESCRIPTION: run_ok Result enum (Ok/Err) with safe_div — Stage 14.60
// EXPECTED: run_ok
// EXPECTED_STDOUT: 20\n-1
// SOURCE: Stage 14.60 — enum with data + match dispatch for error handling

enum Result {
    Ok(i32),
    Err(i32),
}
fn safe_div(a: i32, b: i32) -> Result {
    if b == 0 {
        Result::Err(-1)
    } else {
        Result::Ok(a / b)
    }
}
fn main() -> i32 {
    let r1 = safe_div(100, 5);
    let r2 = safe_div(100, 0);
    match r1 {
        Result::Ok(v) => { println!("{}", v); }
        Result::Err(e) => { println!("{}", e); }
    }
    match r2 {
        Result::Ok(v) => { println!("{}", v); }
        Result::Err(e) => { println!("{}", e); }
    }
    0
}
