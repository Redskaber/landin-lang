// CATEGORY: e2e
// DESCRIPTION: run_ok comparison operators all branches (<=, >=, ==, !=, <, >)
// EXPECTED: run_ok
// EXPECTED_STDOUT: true true true true\ntrue true false false
// SOURCE: Stage 14.25 — comparison edge cases verification

fn main() -> i32 {
    let a = 3 <= 7;   // true
    let b = 5 <= 5;   // true
    let c = 10 >= 5;  // true
    let d = 5 >= 5;   // true
    println!("{} {} {} {}", a, b, c, d);
    let e = 5 == 5;   // true
    let f = 5 != 6;   // true
    let g = 5 == 6;   // false
    let h = 5 != 5;   // false
    println!("{} {} {} {}", e, f, g, h);
    0
}
