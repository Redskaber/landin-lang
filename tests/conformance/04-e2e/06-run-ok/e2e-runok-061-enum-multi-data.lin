// DESCRIPTION: run_ok enum with multiple data variants + match dispatch — Stage 14.42
// EXPECTED: run_ok
// EXPECTED_STDOUT: 12 12 6
// SOURCE: Stage 14.42 — verifies enum variant data access + match arms

enum Shape {
    Circle(i32),
    Rect(i32, i32),
    Triangle(i32, i32, i32),
}
fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Triangle(a, b, c) => a + b + c,
    }
}
fn main() -> i32 {
    let c = area(Shape::Circle(2));
    let r = area(Shape::Rect(3, 4));
    let t = area(Shape::Triangle(1, 2, 3));
    println!("{} {} {}", c, r, t);
    0
}
