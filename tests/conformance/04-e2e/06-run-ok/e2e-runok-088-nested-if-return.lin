// DESCRIPTION: run_ok nested if-else chain with early returns — Stage 14.53
// EXPECTED: run_ok
// EXPECTED_STDOUT: -1 0 1 2
// SOURCE: Stage 14.53 — 4-branch if-else with early returns verification

fn check(n: i32) -> i32 {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else if n < 10 {
        return 1;
    } else {
        return 2;
    }
}
fn main() -> i32 {
    println!("{} {} {} {}", check(-5), check(0), check(5), check(100));
    0
}
