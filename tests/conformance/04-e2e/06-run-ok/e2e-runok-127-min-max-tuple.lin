// CATEGORY: e2e
// DESCRIPTION: run_ok Min/max with while loop — Stage 14.68
// EXPECTED: run_ok
// EXPECTED_STDOUT: 1 5
// SOURCE: Stage 14.68 — audit verified min_max function returning tuple, with while loop
// and multiple conditionals

fn min_max(arr: [i32; 5]) -> (i32, i32) {
    let mut min = arr[0];
    let mut max = arr[0];
    let mut i = 1;
    while i < 5 {
        if arr[i] < min {
            min = arr[i];
        }
        if arr[i] > max {
            max = arr[i];
        }
        i = i + 1;
    }
    (min, max)
}

fn main() -> i32 {
    let mm = min_max([3, 1, 4, 1, 5]);
    println!("{} {}", mm.0, mm.1);  // 1 5
    0
}
