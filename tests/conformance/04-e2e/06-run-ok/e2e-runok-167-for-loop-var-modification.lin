// CATEGORY: e2e
// DESCRIPTION: For-loop variable modification doesn't affect iteration (Bug Z6)
// EXPECTED: run_ok
// EXPECTED_STDOUT: 510
// EXPECTED_EXIT_CODE: 0
// SOURCE: Stage 14.99 — Bug Z6 fix (hidden counter, modifying loop var doesn't end iteration)

fn main() {
    let mut sum = 0;
    for mut i in 0..5 {
        i = i + 100;  // modify the loop variable
        sum += i;
    }
    // Rust semantics: i is a fresh binding each iteration.
    // i=0 -> 100, i=1 -> 101, i=2 -> 102, i=3 -> 103, i=4 -> 104
    // sum = 100+101+102+103+104 = 510
    println!("{}", sum);
}
