struct Pair(i32, i32);
impl Pair {
    fn new(a: i32, b: i32) -> Pair { Pair(a, b) }
    fn sum(self) -> i32 { self.0 + self.1 }
    fn first(self) -> i32 { self.0 }
}
fn main() -> i32 {
    let p = Pair::new(10, 20);
    println!("{} {}", p.sum(), p.first());
    0
}
