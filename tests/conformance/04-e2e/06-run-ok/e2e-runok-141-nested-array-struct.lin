// CATEGORY: e2e
// DESCRIPTION: run_ok Nested array struct [[i32; 5]; 5] with methods — Stage 14.79
// EXPECTED: run_ok
// EXPECTED_STDOUT: 10\n20\n165
// SOURCE: Stage 14.79 — fixed nested array [val; N] element type: was TyKind::Error (resolved
// to i32), causing [[i32; 5]; 5] to have wrong alloca type. Fixed by using actual element type.

struct Grid {
    cells: [[i32; 5]; 5],
}
impl Grid {
    fn new() -> Grid { Grid { cells: [[0; 5]; 5] } }
    fn set(&mut self, r: i32, c: i32, v: i32) { self.cells[r][c] = v; }
    fn get(&self, r: i32, c: i32) -> i32 { self.cells[r][c] }
    fn row_max(&self, r: i32) -> i32 {
        let mut max = self.cells[r][0];
        let mut c = 1;
        while c < 5 {
            if self.cells[r][c] > max { max = self.cells[r][c]; }
            c = c + 1;
        }
        max
    }
    fn total(&self) -> i32 {
        let mut sum = 0;
        let mut r = 0;
        while r < 5 {
            let mut c = 0;
            while c < 5 { sum = sum + self.cells[r][c]; c = c + 1; }
            r = r + 1;
        }
        sum
    }
}

fn main() -> i32 {
    let mut g = Grid::new();
    g.set(0, 0, 10);
    g.set(0, 1, 20);
    g.set(0, 2, 5);
    g.set(1, 0, 30);
    g.set(4, 4, 100);
    println!("{}", g.get(0, 0));   // 10
    println!("{}", g.row_max(0));  // 20
    println!("{}", g.total());     // 165
    0
}
