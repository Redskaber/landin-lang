// CATEGORY: e2e
// DESCRIPTION: run_ok Match with binding (n => { ... }) + if-else chain — Stage 14.77
// EXPECTED: run_ok
// EXPECTED_STDOUT: 0\n1\n2\n3\n4
// SOURCE: Stage 14.77 — match binding `n => { ... }` was uninitialized (read stack garbage).
// Fixed by assigning scrutinee value to the binding local in the otherwise block.

fn classify_score(score: i32) -> i32 {
    match score {
        0 => 0,
        n => {
            if n < 50 { 1 }
            else if n < 70 { 2 }
            else if n < 90 { 3 }
            else { 4 }
        }
    }
}

fn main() -> i32 {
    println!("{}", classify_score(0));
    println!("{}", classify_score(30));
    println!("{}", classify_score(60));
    println!("{}", classify_score(80));
    println!("{}", classify_score(95));
    0
}
