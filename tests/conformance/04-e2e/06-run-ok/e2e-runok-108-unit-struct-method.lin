// CATEGORY: e2e
// DESCRIPTION: run_ok Unit struct (zero-field) with method call — Stage 14.63
// EXPECTED: run_ok
// EXPECTED_STDOUT: 42\n100
// SOURCE: Stage 14.63 — zero-field structs were mapped to EmitType::Void, causing method calls to pass null as &self

struct Unit;
impl Copy for Unit {}
impl Unit {
    fn new() -> Unit { Unit }
    fn value(&self) -> i32 { 42 }
    fn set_value(&self, v: i32) -> i32 { v + 100 }
}

fn main() -> i32 {
    let u = Unit::new();
    println!("{}", u.value());
    println!("{}", u.set_value(0));
    0
}
