// CATEGORY: e2e
// DESCRIPTION: impl multiple traits
// EXPECTED: compile_ok
// SOURCE: Stage 10.4 conformance expansion (Stage 0 — compiles but runtime behavior may differ)

trait A { fn a(&self) -> i32; } trait B { fn b(&self) -> i32; } struct S; impl A for S { fn a(&self) -> i32 { 1 } } impl B for S { fn b(&self) -> i32 { 2 } } fn main() { let s = S; s.a(); }
