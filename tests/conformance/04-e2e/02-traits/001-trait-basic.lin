// CATEGORY: e2e
// DESCRIPTION: basic trait definition and impl
// EXPECTED: compile_ok
// SOURCE: Stage 10.4 conformance expansion (Stage 0 — compiles but runtime behavior may differ)

trait T { fn f(&self) -> i32; } struct S; impl T for S { fn f(&self) -> i32 { 1 } } fn main() { let s = S; s.f(); }
