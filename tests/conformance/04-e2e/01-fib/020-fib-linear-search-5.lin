// CATEGORY: e2e
// DESCRIPTION: linear search 5 — array-by-value parameter works (Stage 14.80)
// EXPECTED: compile_ok
// SOURCE: Stage 11.4 e2e expansion (was Stage 0 limitation, fixed by
//         array-by-value passing + typeck fixes through Stages 14.x)

fn search(arr:[i32;5],target:i32)->i32{let mut i=0;while i<5{if arr[i]==target{return i;}i+=1;}-1}
fn main(){ let _ = search([0;5],0); }
