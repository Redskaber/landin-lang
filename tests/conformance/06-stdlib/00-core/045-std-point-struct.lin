// CATEGORY: stdlib
// DESCRIPTION: point struct
// EXPECTED: compile_ok
// SOURCE: Stage 11.8 batch expansion

struct P{x:i32,y:i32} fn dist(p1:P,p2:P)->i32{let dx=p1.x-p2.x;let dy=p1.y-p2.y;dx*dx+dy*dy}
impl Copy for P {}
fn main(){ let _ = P{x: 0,y: 0}; let _ = dist(P{x: 0,y: 0},P{x: 0,y: 0}); }
