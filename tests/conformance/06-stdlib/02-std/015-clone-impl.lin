// CATEGORY: stdlib
// DESCRIPTION: Clone trait pattern
// EXPECTED: compile_ok
// STAGE_13.17: Flipped from compile_error (self binding fix)
// SOURCE: Stage 10.6 conformance expansion

trait Clone { fn clone(&self) -> Self; } struct S { x: i32 } impl Clone for S { fn clone(&self) -> Self { S { x: self.x } } } fn main() { let s = S { x: 1 }; let s2 = s.clone(); }
