// CATEGORY: stdlib
// DESCRIPTION: Default trait pattern
// EXPECTED: compile_ok
// SOURCE: Stage 10.6 conformance expansion (Stage 0 — Default trait impl compiles)

trait Default { fn default() -> Self; } struct S { x: i32 } impl Default for S { fn default() -> Self { S { x: 0 } } } fn main() { let s = S::default(); }
