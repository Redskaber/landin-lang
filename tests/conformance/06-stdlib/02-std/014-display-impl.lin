// CATEGORY: stdlib
// DESCRIPTION: Display trait pattern
// EXPECTED: compile_ok
// STAGE_13.17: Flipped from compile_error (self binding fix)
// SOURCE: Stage 10.6 conformance expansion

trait Display { fn fmt(&self) -> i32; } struct S { x: i32 } impl Display for S { fn fmt(&self) -> i32 { self.x } } fn main() { let s = S { x: 1 }; s.fmt(); }
