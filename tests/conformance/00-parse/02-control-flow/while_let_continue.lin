//! FAIL
//! category: control-flow
//! description: while_let_continue not yet supported in Stage 0 (planned for Stage 1)
//! error_pattern: not yet supported in Stage 0
//! source: Stage 9.3 conformance expansion
enum Opt<T> { Some(T), None } fn f() { let mut it = Opt::Some(1); while let Opt::Some(x) = it { if x > 0 { continue; } it = Opt::None; } }
