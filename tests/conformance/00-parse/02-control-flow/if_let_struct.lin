//! PASS
//! category: control-flow
//! description: if_let_struct now supported (Stage 13.2 TD-031 closure)
//! source: Stage 9.3 conformance expansion
struct P { x: i32, y: i32 } fn f(p: P) { if let P { x, y } = p { let _ = x + y; } }
impl Copy for P {}
fn main(){ let _ = P{x: 0,y: 0}; f(P{x: 0,y: 0}); }
