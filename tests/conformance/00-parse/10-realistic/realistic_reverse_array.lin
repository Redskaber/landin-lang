fn reverse_array(arr: &mut [i32; 5]) { let mut lo = 0; let mut hi = 4; while lo < hi { let tmp = arr[lo]; arr[lo] = arr[hi]; arr[hi] = tmp; lo += 1; hi -= 1; } }
