//! PASS
//! category: realistic
//! description: match enum with data
//! source: Stage 9.11 conformance expansion
enum Shape { Circle(f64), Rect(f64, f64), Triangle(f64, f64, f64) } fn area(s: Shape) -> f64 { match s { Shape::Circle(r) => r * r, Shape::Rect(w, h) => w * h, Shape::Triangle(_, _) => 0.0 } }
fn main(){ let _ = Shape::Circle(0.0); }
