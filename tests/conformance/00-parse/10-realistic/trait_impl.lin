//! PASS
//! category: realistic
//! description: trait impl with self method and struct literal
struct Point { x: i32, y: i32 }
impl Copy for Point {}

impl Point {
    fn new(x: i32, y: i32) -> Self {
        Point { x, y }
    }
    fn distance(&self, other: &Self) -> f64 {
        let dx = (self.x - other.x) as f64;
        let dy = (self.y - other.y) as f64;
        (dx * dx + dy * dy).sqrt()
    }
}
fn main(){ let _ = Point{x: 0,y: 0}; }
