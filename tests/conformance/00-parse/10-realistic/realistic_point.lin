//! PASS
//! category: realistic
//! description: 2D point struct
//! source: Stage 9.11 conformance expansion
struct Point { x: i32, y: i32 } fn new_point(x: i32, y: i32) -> Point { Point { x, y } } fn distance(p1: Point, p2: Point) -> f64 { let dx = (p1.x - p2.x) as f64; let dy = (p1.y - p2.y) as f64; (dx * dx + dy * dy) }
fn main(){ let _ = Point{x: 0,y: 0}; let _ = new_point(0,0); let _ = distance(Point{x: 0,y: 0},Point{x: 0,y: 0}); }
