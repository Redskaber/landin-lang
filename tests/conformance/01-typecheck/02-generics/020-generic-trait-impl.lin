// CATEGORY: typecheck
// DESCRIPTION: generic trait impl with bound
// EXPECTED: compile_ok
// STAGE_13.17: Flipped from compile_error (self binding fix)
// SOURCE: Stage 10.1 conformance expansion (Stage 0 limitation — compiler does not fully support this feature)

trait T { fn f(&self) -> i32; } struct S<X> { x: X } impl<X: T> T for S<X> { fn f(&self) -> i32 { self.x.f() } }
