// CATEGORY: typecheck
// DESCRIPTION: generic with multiple bounds
// EXPECTED: compile_error
// ERROR_PATTERN: error
// SOURCE: Stage 10.1 conformance expansion (Stage 0 limitation — compiler does not fully support this feature)

trait A { fn a(&self) -> i32; } trait B { fn b(&self) -> i32; } fn f<T: A + B>(x: T) -> i32 { x.a() + x.b() }
