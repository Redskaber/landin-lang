// CATEGORY: typecheck
// DESCRIPTION: trait impl for multiple types
// EXPECTED: compile_error
// ERROR_PATTERN: error
// SOURCE: Stage 10.1 conformance expansion (Stage 0 limitation — compiler does not fully support this feature)

trait T { fn f(&self) -> i32; } struct A; struct B; impl T for A { fn f(&self) -> i32 { 1 } } impl T for B { fn f(&self) -> i32 { 2 } }
