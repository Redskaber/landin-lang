// CATEGORY: typecheck
// DESCRIPTION: impl multiple traits for same type
// EXPECTED: compile_ok
// SOURCE: Stage 10.1 conformance expansion

trait A { fn a(&self) -> i32; } trait B { fn b(&self) -> i32; } struct S; impl A for S { fn a(&self) -> i32 { 1 } } impl B for S { fn b(&self) -> i32 { 2 } }
fn main(){ let _ = S; }
