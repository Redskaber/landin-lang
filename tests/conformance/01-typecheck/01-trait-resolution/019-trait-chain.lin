// CATEGORY: typecheck
// DESCRIPTION: chained trait method calls
// EXPECTED: compile_ok
// SOURCE: Stage 10.1 conformance expansion

trait T { fn f(&self) -> i32; fn g(&self) -> i32; } struct S; impl T for S { fn f(&self) -> i32 { 1 } fn g(&self) -> i32 { 2 } } fn main() { let s = S; s.f(); s.g(); }
