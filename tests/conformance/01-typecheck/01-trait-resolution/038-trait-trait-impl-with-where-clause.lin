// CATEGORY: typecheck
// DESCRIPTION: trait impl with where clause
// EXPECTED: compile_ok
// STAGE_13.17: Flipped from compile_error (self binding fix)
// SOURCE: Stage 11.1 typecheck expansion

trait T { fn f(&self) -> i32; } struct S<X> { x: X } impl<X: T> T for S<X> { fn f(&self) -> i32 { self.x.f() } }
