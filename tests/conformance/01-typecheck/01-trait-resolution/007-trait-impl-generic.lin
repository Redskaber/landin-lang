// CATEGORY: typecheck
// DESCRIPTION: generic trait impl
// EXPECTED: compile_error
// ERROR_PATTERN: error
// SOURCE: Stage 10.1 conformance expansion (Stage 0 limitation — compiler does not fully support this feature)

trait Clone { fn clone(&self) -> Self; } struct Foo<T> { x: T } impl<T> Clone for Foo<T> { fn clone(&self) -> Self { Foo { x: self.x } } }
