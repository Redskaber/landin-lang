// CATEGORY: typecheck
// DESCRIPTION: match on enum with lifetime
// EXPECTED: compile_ok
// SOURCE: Stage 10.8 typecheck expansion

enum E<'a> { A(&'a i32), B } fn f(e: E) -> i32 { match e { E::A(r) => *r, E::B => 0 } }
fn main(){ let _ref_0 = 0; let _ref_1 = 0; let _ = E::A(&_ref_0); let _ = f(E::A(&_ref_1)); }
