// CATEGORY: typecheck
// DESCRIPTION: elision rule 3 - self + arg, output gets self lifetime
// EXPECTED: compile_ok
// SOURCE: Stage 15.94 — Lifetime elision conformance tests

struct S { x: i32 }
impl Copy for S {}
impl S { fn get_or(&self, _default: &i32) -> &i32 { &self.x } }
fn main() { let s = S { x: 42 }; let d = 0; let _ = s.get_or(&d); }
