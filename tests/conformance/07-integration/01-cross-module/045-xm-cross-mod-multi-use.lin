// CATEGORY: integration
// DESCRIPTION: cross mod multi use
// EXPECTED: compile_ok
// SOURCE: Stage 11.6+11.7 expansion (Stage 0 limitation)

mod a{pub fn f()->i32{1}} mod b{pub fn g()->i32{2}} mod c{use a::f; use b::g; pub fn sum()->i32{f()+g()}}

fn main(){ let _ = f(); let _ = g(); let _ = sum(); }
